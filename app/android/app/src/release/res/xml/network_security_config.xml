<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de rede do APK de release.

  Regra geral: HTTPS obrigatório. A exceção abaixo existe só para conseguir
  validar o APK de release contra o backend rodando na máquina de
  desenvolvimento, antes de publicar a API.

  Quando o backend estiver em https, apague o <domain-config> (ou este
  arquivo e o AndroidManifest.xml de release inteiro).

  O IP é fixo: se o roteador renovar o DHCP e sua máquina mudar de endereço,
  atualize aqui. Confira com `hostname -I`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.15</domain>
    </domain-config>
</network-security-config>
